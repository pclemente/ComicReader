  "app": {
    "name": "ComicReader",
    "appStoreAppID": "1597314495",
    "releaseVersionGate": "1.6.1"
  },
  "hypothesis": "Leading with the reading experience and free, optional iCloud sync will improve product-page conversion versus the library-first control while retaining library, search, and reading-list proof later in the gallery.",
  "testDesign": {
    "changeType": "screenshot-order-only",
    "treatmentCount": 1,
    "control": {
      "name": "Library-first control",
      "trafficAllocationPercent": 50,
      "order": [
        "library",
        "reader",
        "search",
        "lists",
        "icloud"
      ]
    },
    "treatments": [
      {
        "id": "reader-icloud-first",
        "name": "Reader + iCloud first",
        "trafficAllocationPercent": 50,
        "order": [
          "reader",
          "icloud",
          "library",
          "search",
          "lists"
        ]
      }
    ],
    "assetMutation": "None. The treatment reorders the exact inherited screenshots recorded below."
  },
  "timing": {
    "startDate": null,
    "endDate": null,
    "maximumRunDays": 90,
    "startOnlyWhen": [
      "ComicReader 1.6.1 is live on the App Store.",
      "At least 7 complete days of unchanged 1.6.1 metadata and library-first screenshots have elapsed after the live timestamp.",
      "No release, metadata, icon, app-preview, screenshot-content, pricing, or availability change is running or planned concurrently."
    ],
    "stopWhen": [
      "App Store Connect reports a conclusive result that satisfies the decision rule.",
      "The experiment reaches 90 days.",
      "A material release, metadata, pricing, availability, or product-page change becomes necessary; stop and record the experiment as interrupted before making that change."
    ]
  },
  "isolationRules": [
    "Do not launch during the 1.6.1 release rollout or its first 7 complete live days.",
    "Freeze all tested product-page metadata and creative assets for the experiment duration.",
    "Do not run another Product Page Optimization test or Custom Product Page campaign against the same decision at the same time.",
    "Do not substitute, recompress, crop, retouch, or relocalize any recorded screenshot.",
    "If App Store Connect does not expose a recorded device gallery for this test, leave that gallery unchanged and record the exclusion rather than substituting another size."
  ],
  "measurement": {
    "primaryMetric": "App Store Connect Product Page Optimization conversion-rate improvement for the treatment versus the original product page.",
    "decisionRule": {
      "adoptTreatment": "Only when App Store Connect reports the treatment as conclusively better than the control after the launch gates and isolation rules were satisfied.",
      "retainControl": "Retain the control when App Store Connect reports the treatment as conclusively worse.",
      "inconclusive": "If evidence is insufficient at 90 days, or the test is interrupted, record the result as inconclusive and make no winner claim."
    },
    "lowVolumeWarning": "ComicReader traffic may be too low for a conclusive result within 90 days. Lack of significance is not evidence that the two orders perform equally."
  },
  "execution": {
    "mode": "manual-App-Store-Connect-only",
    "createdInAppStoreConnect": true,
    "scheduled": false,
    "browserChangesPerformed": true,
    "nextAction": "Use the existing draft. After all launch gates pass, capture the baseline, refresh Apple’s duration estimate and start only this test."
  },
